+/// A launcher can ask for a process's first window to stay hidden:
+/// `STARTF_USESHOWWINDOW` with `SW_HIDE`, which script runners such as
+/// `bun run` set so a console child does not flash a console. Windows applies
+/// it to the first show of a top-level window, so a window shown on purpose
+/// stays hidden. Only that first show is replaced, so showing again works.
+fn show_despite_startup_info(hwnd: HWND, show_cmd: u32) {
+    unsafe {
+        if !IsWindowVisible(hwnd).as_bool() {
+            let _ = ShowWindow(hwnd, SHOW_WINDOW_CMD(show_cmd as i32));
+        }
+    }
+}
