diff --git a/crates/gpui/src/gestures.rs b/crates/gpui/src/gestures.rs
index 997b910..39317a0 100644
--- a/crates/gpui/src/gestures.rs
+++ b/crates/gpui/src/gestures.rs
@@ -23,6 +23,77 @@ const SCROLL_EVENT_SEPARATION: Duration = Duration::from_millis(28);
 pub struct OngoingScroll {
     last_event: Option<Instant>,
     axis: Option<Axis>,
+    pub(crate) wheel: SmoothScroll,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct SmoothScroll {
+    started: Option<Instant>,
+    origin: Point<Pixels>,
+    target: Point<Pixels>,
+    last: Point<Pixels>,
+}
+
+impl SmoothScroll {
+    pub(crate) fn cancel(&mut self) {
+        self.started = None;
+    }
+
+    pub(crate) fn active(&self) -> bool {
+        self.started.is_some()
+    }
+
+    fn unchanged(&self, current: Point<Pixels>) -> bool {
+        // Lists reconstruct pixel offsets from an item index plus an offset;
+        // allow the rounding error introduced at item boundaries.
+        (current.x - self.last.x).abs() < px(0.01)
+            && (current.y - self.last.y).abs() < px(0.01)
+    }
+
+    pub(crate) fn push(&mut self, current: Point<Pixels>, delta: Point<Pixels>, now: Instant) {
+        let mut remaining = if self.active() && self.unchanged(current) {
+            self.target - current
+        } else {
+            Point::default()
+        };
+        // Reversing the wheel should respond immediately, not fight queued movement.
+        if f32::from(remaining.x) * f32::from(delta.x) < 0. {
+            remaining.x = px(0.);
+        }
+        if f32::from(remaining.y) * f32::from(delta.y) < 0. {
+            remaining.y = px(0.);
+        }
+        self.origin = current;
+        self.last = current;
+        self.target = current + remaining + delta;
+        self.started = Some(now);
+    }
+
+    pub(crate) fn advance(
+        &mut self,
+        current: Point<Pixels>,
+        minimum: Point<Pixels>,
+        maximum: Point<Pixels>,
+        now: Instant,
+    ) -> Point<Pixels> {
+        let Some(started) = self.started else { return current };
+        // Scrollbar dragging, navigation and anchoring own any external offset change.
+        if !self.unchanged(current) {
+            self.cancel();
+            return current;
+        }
+        self.target.x = self.target.x.clamp(minimum.x, maximum.x);
+        self.target.y = self.target.y.clamp(minimum.y, maximum.y);
+        let progress = (now.saturating_duration_since(started).as_secs_f32() / 0.14).min(1.);
+        let eased = 1. - (1. - progress).powi(3);
+        self.last = self.origin + (self.target - self.origin) * eased;
+        self.last.x = self.last.x.clamp(minimum.x, maximum.x);
+        self.last.y = self.last.y.clamp(minimum.y, maximum.y);
+        if progress >= 1. || self.last == self.target {
+            self.cancel();
+        }
+        self.last
+    }
 }
 
