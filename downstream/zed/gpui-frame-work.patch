+/// Lines shaped in earlier frames that the last frame didn't use. A frame only
+/// reuses what the one before it laid out, so a list row that scrolled out of
+/// view and back, or text behind a closed disclosure, was shaped again, and
+/// shaping a long paragraph takes a few milliseconds.
+///
+/// Two generations, each bounded by the text it holds: when the newer one
+/// fills, the older is dropped and the newer takes its place.
+#[derive(Default)]
+struct RetainedLines {
+    newer: RetainedGeneration,
+    older: RetainedGeneration,
+}
+
+#[derive(Default)]
+struct RetainedGeneration {
+    lines: FxHashMap<Arc<CacheKey>, Arc<LineLayout>>,
+    wrapped_lines: FxHashMap<Arc<CacheKey>, Arc<WrappedLineLayout>>,
+    text_bytes: usize,
+}
+
+impl RetainedLines {
+    const GENERATION_TEXT_BYTES: usize = 256 * 1024;
+
+    fn keep(&mut self, frame: &mut FrameCache) {
+        for (key, line) in frame.lines.drain() {
+            self.newer.text_bytes += key.text.len();
+            self.newer.lines.insert(key, line);
+        }
+        for (key, line) in frame.wrapped_lines.drain() {
+            self.newer.text_bytes += key.text.len();
+            self.newer.wrapped_lines.insert(key, line);
+        }
+        if self.newer.text_bytes > Self::GENERATION_TEXT_BYTES {
+            self.older = std::mem::take(&mut self.newer);
+        }
+    }
+
+    fn take_line(&mut self, key: &dyn AsCacheKeyRef) -> Option<(Arc<CacheKey>, Arc<LineLayout>)> {
+        self.newer
+            .lines
+            .remove_entry(key)
+            .or_else(|| self.older.lines.remove_entry(key))
+    }
+
+    fn take_wrapped_line(
+        &mut self,
+        key: &dyn AsCacheKeyRef,
+    ) -> Option<(Arc<CacheKey>, Arc<WrappedLineLayout>)> {
+        self.newer
+            .wrapped_lines
+            .remove_entry(key)
+            .or_else(|| self.older.wrapped_lines.remove_entry(key))
+    }
+}
